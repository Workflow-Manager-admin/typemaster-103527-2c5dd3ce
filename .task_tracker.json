{
  "task_description": "{'component_name': 'Main Container for TypeMaster', 'description': 'Primary container for TypeMaster implementation: TypeRush is a web app where users can test their typing speed and accuracy through timed challenges. Users can sign up, log in, and compete on a global leaderboard. The app tracks user stats, supports dark mode, and is fully responsive. Admins can manage test texts.', 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "User Authentication",\n      "description": "Signup and login system with display of logged-in user\'s name and total tests taken.",\n      "isEnabled": true\n    },\n    {\n      "name": "Typing Test",\n      "description": "Presents a random sentence or paragraph to type, starts timer on typing, shows real-time WPM, accuracy, time left, and highlights mistakes.",\n      "isEnabled": true\n    },\n    {\n      "name": "Score Submission",\n      "description": "After test, calculates and stores WPM, accuracy, time taken, test text, and date/time.",\n      "isEnabled": true\n    },\n    {\n      "name": "Leaderboard",\n      "description": "Displays top 10 users based on WPM and accuracy with filters for Today, This Week, and All Time.",\n      "isEnabled": true\n    },\n    {\n      "name": "Profile Page",\n      "description": "Shows user\'s past test results, average WPM and accuracy, and allows deletion of test history.",\n      "isEnabled": true\n    },\n    {\n      "name": "Admin Panel",\n      "description": "Admins can add, edit, or delete test texts. Admin-only access. (Optional)",\n      "isEnabled": false\n    },\n    {\n      "name": "Dark Mode Toggle",\n      "description": "Supports light and dark themes for user preference.",\n      "isEnabled": true\n    },\n    {\n      "name": "Responsive Design",\n      "description": "App is fully responsive and works on desktop and mobile devices.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#1976d2",\n    "secondary": "#ffffff",\n    "accent": "#ff9800"\n  },\n  "theme": "light",\n  "layoutDescription": "The main page features a centered typing test area with real-time stats displayed above or beside the text box. Navigation bar at the top includes links to Leaderboard, Profile, and Admin (if admin). User info and dark mode toggle are in the header. Leaderboard and profile pages use card or table layouts. The design adapts for mobile with stacked elements and collapsible menus."\n}'}",
